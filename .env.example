# Copy to .env and adjust. All values are optional.
HOST=0.0.0.0
# The ChatGPT sign-in returns to http://127.0.0.1:<PORT>/auth/callback.
PORT=3210
DB_PATH=./data/pantry.db
SESSION_DAYS=30
# Address phones use to reach this app (QR sign-in); detected from your Wi-Fi/Ethernet if unset.
# PUBLIC_URL=http://192.168.1.20:3210

# Stored ChatGPT tokens are encrypted. Without APP_SECRET a random key is created at data/secret.key
# (back it up with the database, or everyone has to sign in again).
# APP_SECRET=

# Model used for everyone unless a user picks one; empty = the first model each user's plan offers.
CHATGPT_MODEL=gpt-6.1-sol        # recommended; "" = first model each plan lists
CHATGPT_SCAN_EFFORT=low         # reasoning effort for photo -> ingredients
CHATGPT_RECIPE_EFFORT=medium    # reasoning effort for recipe suggestions
CHATGPT_TIMEOUT_MS=180000

# --- One-tap sign-in on every device: registered website client from OpenAI ---
# Apply at https://openai.com/form/sign-in-with-chatgpt-interest/ , register
# <PUBLIC_URL>/auth/callback with OpenAI, then set:
# PUBLIC_URL=https://pantry.example.com
# OPENAI_CLIENT_ID=oaiapp_...
# OPENAI_CLIENT_SECRET=          # only for a confidential client
# OPENAI_SCOPES=                 # only if OpenAI tells you to request different scopes
# TRUST_PROXY=1                  # behind a tunnel / reverse proxy

# --- Production / public access ---
# TRUST_PROXY=1                  # behind nginx or a tunnel
# ALLOWED_EMAILS=you@example.com,partner@example.com   # invite-only; unset = anyone
# OWNER_EMAIL=you@example.com    # gets data created before accounts existed
# BACKUP_DAYS=7                  # daily snapshots in data/backups (0 = off)
